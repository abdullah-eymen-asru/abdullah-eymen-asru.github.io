---
# feed.xml (Atom) ile AYNI birleşik listeyi (blog + akademik projeler) ve
# AYNI tam-metin/mutlak-URL mantığını RSS 2.0 formatında sunan ikinci
# feed. Bazı okuyucular/entegrasyonlar sadece RSS 2.0'ı destekliyor;
# Atom'u destekleyenlerin BÜYÜK ÇOĞUNLUĞU RSS 2.0'ı da destekliyor,
# dolayısıyla iki dosyayı birlikte sunmak en geniş uyumluluğu sağlıyor.
#
# content:encoded (RSS 2.0'ın tam-metin standardı) + dc:creator (yazar,
# post/project.author front-matter alanından okunuyor) + <category>
# (Blog Yazısı / Akademik Proje ayrımı, ayrıca varsa etiket/kategori)
# içeriyor. "Sadece Supabase'te yayınla" projeleri statik build'e hiç
# girmediği için burada da YOK — bkz. feed.xml başındaki not.
layout: none
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ '/' | absolute_url }}</link>
    <atom:link href="{{ '/rss.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
    {% if site.description %}<description>{{ site.description | xml_escape }}</description>{% endif %}
    <language>tr</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }}</generator>

    {% assign blog_yazilari = site.posts | where_exp: "p", "p.yayinda != false" | where_exp: "p", "p.date <= site.time" %}
    {% assign akademik_projeler = site.projects | where_exp: "p", "p.yayinda != false" | where_exp: "p", "p.date <= site.time" %}
    {% assign tum_icerik = blog_yazilari | concat: akademik_projeler | sort: "date" | reverse %}
    {% for post in tum_icerik limit:20 %}
      {% assign yazar_adi = post.author | default: site.author | default: site.title %}
      {% assign icerik_turu = "Blog Yazısı" %}
      {% if post.collection == "projects" %}{% assign icerik_turu = "Akademik Proje" %}{% endif %}
      <item>
        <title>{{ post.title | smartify | xml_escape }}</title>
        <link>{{ post.url | absolute_url }}</link>
        <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
        <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
        <dc:creator>{{ yazar_adi | xml_escape }}</dc:creator>
        <category>{{ icerik_turu }}</category>
        {% for kategori in post.categories %}<category>{{ kategori | xml_escape }}</category>
        {% endfor %}
        {% for etiket in post.tags %}<category>{{ etiket | xml_escape }}</category>
        {% endfor %}
        {% if post.excerpt and post.excerpt != empty %}<description><![CDATA[ {{ post.excerpt | strip_html | normalize_whitespace | truncatewords: 40 }} ]]></description>{% endif %}
        <content:encoded><![CDATA[ {{ post.content | absolutize_urls }} ]]></content:encoded>
      </item>
    {% endfor %}
  </channel>
</rss>

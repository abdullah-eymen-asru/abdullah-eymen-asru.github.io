---
# feed.xml (Atom) ile AYNI yazı listesini ve AYNI tam-metin/mutlak-URL
# mantığını RSS 2.0 formatında sunan ikinci feed. Bazı okuyucular/
# entegrasyonlar (ör. bazı e-posta-ile-abonelik servisleri, eski RSS
# istemcileri) sadece RSS 2.0'ı destekliyor; Atom'u destekleyenlerin
# BÜYÜK ÇOĞUNLUĞU RSS 2.0'ı da destekliyor, dolayısıyla iki dosyayı
# birlikte sunmak en geniş uyumluluğu sağlıyor.
#
# content:encoded (RSS 2.0'ın tam-metin standardı) + dc:creator (yazar,
# birden fazla yazar olabileceği için post.author front-matter alanından
# okunuyor) + <category> (varsa etiket/kategori) içeriyor.
layout: none
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ '/' | absolute_url }}</link>
    <atom:link href="{{ '/rss.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
    {% if site.description %}<description>{{ site.description | xml_escape }}</description>{% endif %}
    <language>tr</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }}</generator>

    {% assign yayindaki_yazilar = site.posts | where_exp: "p", "p.yayinda != false" | where_exp: "p", "p.date <= site.time" %}
    {% for post in yayindaki_yazilar limit:20 %}
      {% assign yazar_adi = post.author | default: site.author | default: site.title %}
      <item>
        <title>{{ post.title | smartify | xml_escape }}</title>
        <link>{{ post.url | absolute_url }}</link>
        <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
        <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
        <dc:creator>{{ yazar_adi | xml_escape }}</dc:creator>
        {% for kategori in post.categories %}<category>{{ kategori | xml_escape }}</category>
        {% endfor %}
        {% for etiket in post.tags %}<category>{{ etiket | xml_escape }}</category>
        {% endfor %}
        {% if post.excerpt and post.excerpt != empty %}<description><![CDATA[ {{ post.excerpt | strip_html | normalize_whitespace | truncatewords: 40 }} ]]></description>{% endif %}
        <content:encoded><![CDATA[ {{ post.content | absolutize_urls }} ]]></content:encoded>
      </item>
    {% endfor %}
  </channel>
</rss>
